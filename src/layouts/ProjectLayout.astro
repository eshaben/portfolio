---
import BaseLayout from "./BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import { withBase } from "../consts";

interface Props {
  data: CollectionEntry<"projects">["data"];
}
const { data } = Astro.props;
const { title, description, tech, links } = data;

// Turn the links object into an array we can loop over, keeping only the ones
// that were actually set in the frontmatter.
const linkList = (
  [
    ["Live demo", links.demo],
    ["Repository", links.repo],
    ["Documentation", links.docs],
  ] as const
).filter(([, url]) => Boolean(url)) as [string, string][];
---

<BaseLayout title={`${title} — Projects`} description={description}>
  <article class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    <header class="mb-10">
      <a
        href={withBase("/projects")}
        class="text-sm text-muted transition-colors hover:text-ink"
      >
        &larr; All projects
      </a>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink md:text-4xl">
        {title}
      </h1>
      <p class="mt-3 text-muted">{description}</p>

      {
        tech.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {tech.map((t) => (
              <li class="rounded border border-line px-2 py-0.5 text-xs text-muted">
                {t}
              </li>
            ))}
          </ul>
        )
      }

      {
        linkList.length > 0 && (
          <p class="mt-5 flex flex-wrap gap-4 text-sm">
            {linkList.map(([label, url]) => (
              <a class="text-accent underline underline-offset-2" href={url}>
                {label}
              </a>
            ))}
          </p>
        )
      }
    </header>

    <div class="prose prose-neutral max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
