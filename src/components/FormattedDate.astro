---
// Renders a Date as a <time> element with a machine-readable datetime attribute
// and human text like "August 15, 2024".
interface Props {
  date: Date;
}
const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  }
</time>
