---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  post: CollectionEntry<"writing">;
}
const { post } = Astro.props;
const { title, description, pubDate } = post.data;
---

<a
  href={`/writing/${post.id}`}
  class="group block rounded-lg border border-line p-5 transition-colors hover:border-ink"
>
  <h3 class="font-medium text-ink group-hover:text-accent">{title}</h3>
  <p class="mt-1.5 text-sm text-muted">{description}</p>
  <p class="mt-3 text-xs text-muted">
    <FormattedDate date={pubDate} />
  </p>
</a>
